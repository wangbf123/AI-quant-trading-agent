# Copy to .env for local development. Never commit credentials.
# Store cloud API keys securely in environment settings.
AQR_LLM_API_KEY=
AQR_LLM_PROTOCOL=anthropic
AQR_LLM_BASE_URL=https://api.stepfun.com/step_plan
AQR_LLM_MODEL=step-5-preview
# Native Anthropic API-key headers; use bearer if required by your provider.
AQR_LLM_AUTH_MODE=api_key
AQR_DATA_DIR=data/results/research
# Empty uses SQLite and local threads; set both to enable PostgreSQL + Redis/RQ.
AQR_DATABASE_URL=
AQR_REDIS_URL=
LOG_LLM_CHAT_CONTENT=false
MAX_RETRY=3
RETRY_WAIT_SECONDS=2
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# The original factor-mining page also uses the upstream names:
# OPENAI_API_KEY / OPENAI_BASE_URL / CHAT_MODEL / REASONING_MODEL
# QLIB_DATA_DIR / DATA_RESULTS_DIR
